# Copier en .env pour docker compose (le fichier .env est ignoré par git).
# Aucune vraie valeur ici : ce fichier est public.
POSTGRES_PASSWORD=changez-moi
# Générer une entrée avec : python -m scripts.new_api_key --name dev --role admin --days 7
API_KEYS=[]
RATE_LIMIT_PER_MINUTE=60
DOCS_ENABLED=true

# Base analytique MongoDB pour l'entraînement (ADR-0006, docker-compose.prod.yml)
MONGO_USER=changez-moi
MONGO_PASSWORD=changez-moi
MONGO_DB=livraison_express
MONGO_COLLECTION=orders

# Streaming RabbitMQ (TP6) — l'utilisateur « guest » ne fonctionne pas entre conteneurs
RABBITMQ_USER=changez-moi
RABBITMQ_PASSWORD=changez-moi
RABBITMQ_QUEUE=delivery_orders
